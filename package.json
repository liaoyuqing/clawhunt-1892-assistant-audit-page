{
  "name": "clawhunt-1892-assistant-audit-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "会员空间平台 · 助手对话审计页（会话检索 / 详情回放 / 导出）— React + TypeScript + TDesign + MSW",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "dayjs": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.26.2",
    "tdesign-icons-react": "^0.4.1",
    "tdesign-react": "^1.11.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "msw": "^2.4.9",
    "playwright": "^1.47.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}